# Copy this file to .streamlit/secrets.toml for local Streamlit runs, or paste its
# contents into the "Secrets" box when deploying on Streamlit Community Cloud
# (share.streamlit.io -> your app -> Settings -> Secrets). Never commit the real
# secrets.toml -- it's already in .gitignore.

# Keep the dataset small on a resource-capped free-tier deploy so first-run
# generation + embedding finishes quickly. Omit for the full 12 months locally.
RELPLATFORM_MONTHS = "3"

# "mock" (default, always works, no external calls) | "gemini" | "ollama" (local only --
# won't work on a cloud deploy, there's no Ollama server to reach).
RELPLATFORM_PROVIDER = "mock"

# Only needed if RELPLATFORM_PROVIDER = "gemini". Get a free-tier key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY = ""
